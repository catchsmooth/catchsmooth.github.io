---
import { getCatalog } from '../lib/catalog';
const { guides } = await getCatalog();
---

<div class="guide-list">
  {guides.map((guide) => (
    <a class="guide-item" href={`/guides/${guide.id}/`}>
      <span class="guide-symbol" aria-hidden="true">
        {['⌘', '↔', '{ }'][guide.data.order - 1]}
      </span>
      <div>
        <h3>{guide.data.title}</h3>
        <p>{guide.data.description}</p>
        <span>{guide.data.resources.length} 个官方入口 · 阅读路径</span>
      </div>
      <span class="guide-arrow" aria-hidden="true">
        ↗
      </span>
    </a>
  ))}
</div>
